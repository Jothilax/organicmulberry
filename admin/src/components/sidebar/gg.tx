/* overlay covers whole viewport so sidebar appears above everything */
.sidebarOverlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: stretch;
  z-index: 2000; /* make sure this is higher than the header */
}

/* the sliding panel */
.sidebar {
  width: 200px;
  max-width: 50%;
  background: beige;
  height: 100vh;
  padding: 20px;
  box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
  transform: translateX(-10px);
  animation: slideIn 240ms ease forwards;
  overflow-y: auto;
}

/* simple close button */
.closeBtn {
  background: none;
  border: none;
  font-size: 20px;
  cursor: pointer;
  margin-bottom: 12px;
  padding: 6px;
}

/* menu styles */
.menuList {
  list-style: none;
  padding: 0;
  margin: 0;
}

.menuList li {
  margin: 12px 0;
}

.menuList a {
  display: block;
  text-decoration: none;
  color: #333;
  font-size: 16px;
  padding: 8px 6px;
  border-radius: 6px;
}

.menuList a:hover,
.menuList a:focus {
  background: rgba(0, 0, 0, 0.05);
  outline: none;
}

/* slide in animation */
@keyframes slideIn {
  from { transform: translateX(-100%); }
  to   { transform: translateX(0); }
}

/* responsive tweak */
@media (max-width: 480px) {
  .sidebar {
    width: 85%;
  }
}
